{
  "name": "cannabis-pos-laravel",
  "description": "Cannabis Point of Sale System - Laravel Backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "vite --config vite.config.js",
    "build": "vite build",
    "build:production": "node build-production.js && npm run build",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "hot": "vite --host",
    "prod": "npm run build:production && php artisan optimize",
    "production:setup": "./scripts/setup-production.sh",
    "production:build": "npm run build:production && php artisan config:cache && php artisan route:cache && php artisan view:cache",
    "fresh": "php artisan migrate:fresh --seed && npm run dev",
    "setup": "composer install && npm install && cp .env.example .env && php artisan key:generate && php artisan migrate --seed",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "alpinejs": "^3.14.9",
    "axios": "^1.6.0",
    "express": "^5.1.0",
    "laravel-vite-plugin": "^0.8.0",
    "qrious": "^4.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.2",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "class-variance-authority": "^0.7.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@tanstack/react-query": "^5.59.17",
    "cmdk": "^1.0.0",
    "react-day-picker": "^8.10.1",
    "input-otp": "^1.2.5",
    "react-resizable-panels": "^2.0.20",
    "react-hook-form": "^7.52.1",
    "embla-carousel-react": "^8.3.0",
    "recharts": "^2.12.7",
    "vaul": "^0.9.5",
    "sonner": "^1.5.0",
    "next-themes": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "keywords": [
    "cannabis",
    "pos",
    "point-of-sale",
    "laravel",
    "php",
    "metrc",
    "oregon",
    "dispensary",
    "retail"
  ],
  "author": "Cannabis POS Team",
